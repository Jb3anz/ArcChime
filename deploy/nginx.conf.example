# /etc/nginx/sites-available/arcchime  (then symlink into sites-enabled, nginx -t, reload,
# and get a certificate, e.g.: sudo certbot --nginx -d chime.your-domain.example)
server {
    listen 80;
    server_name chime.your-domain.example;

    location / {
        proxy_pass http://127.0.0.1:8810;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
