# Copy to /etc/arcchime.env, then: sudo chown root:arcchime /etc/arcchime.env && sudo chmod 640 /etc/arcchime.env
# No quotes around values. Values are NOT expanded inside this file, so write the port out in DEMO_URL too.
ARCCHIME_PORT=8810
ARC_RPC=https://rpc.mainnet.arc.io
CHAIN_ID=5042
CONFIRMATIONS=2
DB_PATH=/var/lib/arcchime/arcchime.db
BACKFILL_BLOCKS=5000
# Generate long random values: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_TOKEN=CHANGE_ME
DEMO_ADDRESS=0xYourReceivingAddress
DEMO_SECRET=CHANGE_ME_TOO
# The shop's own webhook on this same server (trusted because the operator sets it). Same port as above.
DEMO_URL=http://127.0.0.1:8810/shop/webhook
