# Arc testnet (default)
ARC_RPC=https://rpc.testnet.arc.network
CHAIN_ID=5042002
# Arc mainnet: take the RPC URL from the official Arc docs
# ARC_RPC=https://rpc.mainnet.arc.io
# CHAIN_ID=5042

CONFIRMATIONS=2
DB_PATH=arcchime.db
# Strongly recommended for any public deployment:
ADMIN_TOKEN=change-me-to-a-long-random-string
# Local testing ONLY (turns off the SSRF guard):
# ALLOW_PRIVATE_URLS=1
# ALLOW_HTTP_URLS=1

# Demo shop (optional; see README). On a public host DEMO_URL must be https://<your-host>/shop/webhook
# DEMO_ADDRESS=0xYourReceivingAddress
# DEMO_SECRET=another-long-random-string
# DEMO_URL=https://your-host.example/shop/webhook
# SHOP_SECRET_MESSAGE=You found it.
